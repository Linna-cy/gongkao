<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Monitoring on Nimbus</title><link>/gongkao/tags/monitoring/</link><description>Recent content in Monitoring on Nimbus</description><generator>Hugo</generator><language>en-us</language><lastBuildDate>Wed, 15 Mar 2023 11:00:00 -0700</lastBuildDate><atom:link href="/gongkao/tags/monitoring/index.xml" rel="self" type="application/rss+xml"/><item><title>Building an Observability Stack with Prometheus and Grafana</title><link>/gongkao/blog/post-3/</link><pubDate>Wed, 15 Mar 2023 11:00:00 -0700</pubDate><guid>/gongkao/blog/post-3/</guid><description>&lt;p&gt;Most teams don&amp;rsquo;t have a metrics problem — they have a &lt;em&gt;too many&#10;dashboards nobody looks at&lt;/em&gt; problem. This is the minimal setup we use to&#10;go from &amp;ldquo;no visibility&amp;rdquo; to &amp;ldquo;useful alerts and three dashboards people&#10;actually open during an incident.&amp;rdquo;&lt;/p&gt;&#10;&lt;p&gt;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&lt;span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-sky-50 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300"&gt;Prometheus v2.51&lt;/span&gt;&#10;&#10; &#10; &#10; &#10; &#10; &#10; &#10; &#10; &#10; &lt;a href="https://grafana.com" target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-purple-50 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300 hover:opacity-80 transition-opacity"&gt;Grafana v10.4&lt;/a&gt;&#10; &#10;&lt;/p&gt;&#10;&lt;p&gt;&lt;img src="bryce-canyon.jpg" alt="Bryce Canyon National Park"&gt;&lt;/p&gt;</description></item></channel></rss>